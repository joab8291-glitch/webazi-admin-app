{
  "expo": {
    "name": "Webazi Admin",
    "slug": "webazi-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "webaziadminapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.webazi.admin"
    },
    "android": {
      "package": "com.webazi.admin",
      "adaptiveIcon": {
        "backgroundColor": "#0C9A63"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
